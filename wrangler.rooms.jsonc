{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maydan-rooms",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // إعدادات عامة (غير سرّية). الأسرار عبر `wrangler secret put` — راجع docs/ACCOUNTS.md.
  "vars": {
    "ALLOWED_ORIGINS": "https://mf103871-boop.github.io",
    "APP_ORIGIN": "https://mf103871-boop.github.io",
    "EXTRA_ORIGINS": "maydan://app",
    "APPLE_BUNDLE_ID": "",
    "APPLE_SERVICES_ID": "",
    "GOOGLE_CLIENT_ID": "",
    "PADDLE_ENV": "sandbox",
    "PADDLE_CLIENT_TOKEN": "",
    "PADDLE_PRICE_MONTHLY": "",
    "PADDLE_PRICE_YEARLY": ""
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITERS", "class_name": "RequestLimiter" }
    ]
  },
  // القاعدة نفسها التي يستعملها maydan-game (حساب واحد يخدم الواجهتين). اختيارية
  // حتى تُنشأ: أزل التعليق وضع المعرّف نفسه الذي وضعته في wrangler.jsonc.
  "d1_databases": [
    { "binding": "DB", "database_name": "maydan-accounts", "database_id": "9d863a31-6a5c-45f1-91f5-79ad400c3f6e", "migrations_dir": "server/migrations" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "RequestLimiter"] }
  ],
  // تنظيف يومي للجلسات المنتهية ورموز الدخول وسجل webhooks (server/accounts/cleanup.mjs).
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": false }
}
