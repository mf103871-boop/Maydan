{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maydan-rooms",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://mf103871-boop.github.io"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITERS", "class_name": "RequestLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "RequestLimiter"] }
  ],
  "observability": { "enabled": false }
}
