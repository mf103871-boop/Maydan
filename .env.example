# Live preparation template only. This file is not loaded by the deployed Worker.
# Runtime values are environment bindings/secrets; never commit a populated copy.
# Use an isolated staging Worker/database until account and domains are approved.
# Keep wrangler.jsonc and wrangler.rooms.jsonc Sandbox values unchanged meanwhile.
PADDLE_ENV=production
PADDLE_CHECKOUT_ENABLED=false
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Live Maydan Plus: USD 5 every month (amount 500). Do not use Sandbox IDs.
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
# API host is selected automatically from PADDLE_ENV; no override in live.
# Live webhook IPs are fetched from https://api.paddle.com/ips, never pasted here.
