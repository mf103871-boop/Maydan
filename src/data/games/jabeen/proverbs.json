{
 "id": "proverbs",
 "name": "أمثال شعبية",
 "icon": "💬",
 "items": [
  {
   "id": "jabeen-proverbs-001",
   "text": "الصديق وقت الضيق"
  },
  {
   "id": "jabeen-proverbs-002",
   "text": "العين بصيرة واليد قصيرة"
  },
  {
   "id": "jabeen-proverbs-003",
   "text": "اللي فات مات"
  },
  {
   "id": "jabeen-proverbs-004",
   "text": "الطيور على أشكالها تقع"
  },
  {
   "id": "jabeen-proverbs-005",
   "text": "رب ضارة نافعة"
  },
  {
   "id": "jabeen-proverbs-006",
   "text": "من جدّ وجد"
  },
  {
   "id": "jabeen-proverbs-007",
   "text": "الصبر مفتاح الفرج"
  },
  {
   "id": "jabeen-proverbs-008",
   "text": "القناعة كنز لا يفنى"
  },
  {
   "id": "jabeen-proverbs-009",
   "text": "في التأني السلامة"
  },
  {
   "id": "jabeen-proverbs-010",
   "text": "الجار قبل الدار"
  },
  {
   "id": "jabeen-proverbs-011",
   "text": "الحاجة أم الاختراع"
  },
  {
   "id": "jabeen-proverbs-012",
   "text": "لكل مقام مقال"
  },
  {
   "id": "jabeen-proverbs-013",
   "text": "الكلام من فضة والسكوت من ذهب"
  },
  {
   "id": "jabeen-proverbs-014",
   "text": "اليد الواحدة لا تصفق"
  },
  {
   "id": "jabeen-proverbs-015",
   "text": "ليس كل ما يلمع ذهبًا"
  },
  {
   "id": "jabeen-proverbs-016",
   "text": "عصفور في اليد خير من عشرة على الشجرة"
  },
  {
   "id": "jabeen-proverbs-017",
   "text": "من طلب العلا سهر الليالي"
  },
  {
   "id": "jabeen-proverbs-018",
   "text": "لا تؤجل عمل اليوم إلى الغد"
  },
  {
   "id": "jabeen-proverbs-019",
   "text": "رجع بخفي حنين"
  },
  {
   "id": "jabeen-proverbs-020",
   "text": "القرد في عين أمه غزال"
  },
  {
   "id": "jabeen-proverbs-021",
   "text": "مصائب قوم عند قوم فوائد"
  },
  {
   "id": "jabeen-proverbs-022",
   "text": "البعيد عن العين بعيد عن القلب"
  },
  {
   "id": "jabeen-proverbs-023",
   "text": "مدّ رجليك على قدر لحافك"
  },
  {
   "id": "jabeen-proverbs-024",
   "text": "خير الكلام ما قل ودل"
  },
  {
   "id": "jabeen-proverbs-025",
   "text": "العلم في الصغر كالنقش على الحجر"
  },
  {
   "id": "jabeen-proverbs-026",
   "text": "رب أخ لم تلده أمك"
  },
  {
   "id": "jabeen-proverbs-027",
   "text": "من شبّ على شيء شاب عليه"
  },
  {
   "id": "jabeen-proverbs-028",
   "text": "اضرب الحديد وهو ساخن"
  },
  {
   "id": "jabeen-proverbs-029",
   "text": "كل إناء بما فيه ينضح"
  },
  {
   "id": "jabeen-proverbs-030",
   "text": "من حفر حفرة لأخيه وقع فيها"
  },
  {
   "id": "jabeen-proverbs-031",
   "text": "ما حك جلدك مثل ظفرك"
  },
  {
   "id": "jabeen-proverbs-032",
   "text": "التكرار يعلّم الشطار"
  },
  {
   "id": "jabeen-proverbs-033",
   "text": "أول الغيث قطرة"
  },
  {
   "id": "jabeen-proverbs-034",
   "text": "لكل جواد كبوة"
  },
  {
   "id": "jabeen-proverbs-035",
   "text": "للحيطان آذان"
  }
 ]
}
