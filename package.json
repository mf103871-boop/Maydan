{
  "name": "maydan-platform",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "ميدان: ألعاب جمعتنا — ألعاب جماعية وغرف رسم وتخمين وصوت من عدة هواتف",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "brand:icons": "node scripts/brand-icons.mjs",
    "ios:prepare": "node scripts/ios/prepare.mjs",
    "test": "node --test --test-concurrency=2 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "mafia:calibrate": "node scripts/mafia-rating-calibrate.mjs",
    "mafia:acceptance": "node scripts/mafia-acceptance-report.mjs",
    "e2e:smoke": "node scripts/e2e/smoke.mjs",
    "e2e:startup-images": "node scripts/e2e/startup-images.mjs",
    "e2e:sw": "node --test tests/e2e/sw-navigation.mjs",
    "bank:alt": "node scripts/bank.mjs alt",
    "release": "node scripts/release.mjs",
    "bank:validate": "node scripts/bank.mjs validate",
    "bank:report": "node scripts/bank.mjs report",
    "bank:placeholders": "node scripts/bank.mjs placeholders",
    "bank:sort": "node scripts/bank.mjs sort",
    "bank:status": "node scripts/bank.mjs status",
    "media:fetch": "node scripts/media-fetch.mjs",
    "e2e:media": "node scripts/e2e/media-render.cjs",
    "e2e:offline": "node scripts/e2e/media-offline.cjs",
    "e2e:paywall": "node scripts/e2e/paywall.mjs",
    "rooms:dev": "node scripts/rooms-dev.mjs",
    "ersomha:check": "node scripts/ersomha-content.mjs",
    "ersomha:latency": "node scripts/ersomha-latency.mjs",
    "e2e:ersomha": "node tests/e2e/ersomha-online.mjs",
    "rooms:check": "wrangler deploy --config wrangler.rooms.jsonc --dry-run --outdir .wrangler/check",
    "rooms:deploy": "wrangler deploy --config wrangler.rooms.jsonc",
    "test:rooms": "node --test --test-concurrency=2 tests/online-*.test.js",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "cloudflare:check": "wrangler deploy --dry-run --outdir .wrangler/full-check",
    "cloudflare:deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply maydan-accounts --remote",
    "db:migrate:local": "wrangler d1 migrations apply maydan-accounts --local",
    "art:alpha": "node scripts/art-alpha.mjs",
    "art:check": "node scripts/art-alpha.mjs --check",
    "audio:fetch": "node scripts/audio/sources.mjs --fetch",
    "audio:screen": "node scripts/audio/screen.mjs",
    "audio:build": "node scripts/audio/build.mjs && node scripts/audio/music.mjs && node scripts/audio/credits.mjs && node scripts/audio/selected.mjs",
    "audio:audition": "node scripts/audio/audition.mjs",
    "audio:check": "node scripts/audio/sources.mjs --check && node scripts/audio/build.mjs --check && node scripts/audio/music.mjs --check && node scripts/audio/credits.mjs --check && node scripts/audio/selected.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "livekit-client": "2.22.4",
    "qrcode": "1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "ffmpeg-static": "^5.3.0",
    "miniflare": "5.20261006.1-alpha",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "wrangler": "4.149.0",
    "ws": "8.21.3"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
