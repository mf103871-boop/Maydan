{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maydan-game",
  "main": "server/full-worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "build": { "command": "npm run build:cloudflare" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/health"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITERS", "class_name": "RequestLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "RequestLimiter"] }
  ],
  "observability": { "enabled": false }
}
