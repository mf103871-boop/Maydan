{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maydan-game",
  "main": "server/full-worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "build": { "command": "npm run build:cloudflare" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*", "/health"],
    "not_found_handling": "single-page-application"
  },
  // إعدادات عامة (غير سرّية). الأسرار عبر `wrangler secret put` — راجع docs/ACCOUNTS.md.
  "vars": {
    "APP_ORIGIN": "",
    "EXTRA_ORIGINS": "maydan://app",
    "APPLE_BUNDLE_ID": "",
    "APPLE_SERVICES_ID": "",
    "GOOGLE_CLIENT_ID": "436944195283-042ike8qeg0636ndima1ehj17bhh3acb.apps.googleusercontent.com",
    "PADDLE_ENV": "sandbox",
    "PADDLE_CLIENT_TOKEN": "test_9ce6eae313e37236bdd56ff84c0",
    "PADDLE_PRICE_MONTHLY": "pri_01m2p9gbanyptbz5hdf350ktet",
    "PADDLE_PRICE_YEARLY": "pri_01m2p9gbmv4tyx2q203e035ye9"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITERS", "class_name": "RequestLimiter" }
    ]
  },
  // قاعدة الحسابات (اختيارية حتى تُنشأ): بدون الربط ينشر العامل ويعمل، والغرف كما
  // كانت، وتردّ مسارات الحسابات 404 فتعمل الواجهة «دون اتصال» (قفل بلا شراء).
  // أنشئها مرة واحدة بـ`npx wrangler d1 create maydan-accounts`، أزل التعليق عن
  // الكتلة التالية وضع المعرّف الذي يطبعه الأمر، ثم `npm run db:migrate`.
  // لا تنشر بمعرّف وهمي: Cloudflare يرفض النشر كله حين لا تُطابق القاعدة الحساب.
  "d1_databases": [
    { "binding": "DB", "database_name": "maydan-accounts", "database_id": "9d863a31-6a5c-45f1-91f5-79ad400c3f6e", "migrations_dir": "server/migrations" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "RequestLimiter"] }
  ],
  // تنظيف يومي للجلسات المنتهية ورموز الدخول وسجل webhooks (server/accounts/cleanup.mjs).
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": false }
}
